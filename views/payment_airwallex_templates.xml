<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Airwallex 內嵌表單（維持不變） -->
    <template id="airwallex_inline_form">
        <div t-att-data-provider-id="provider_id" 
             t-att-data-provider-code="'airwallex'"
             class="o_airwallex_inline_form">
            <div id="dropIn" style="margin: 10px 0;"></div>
            <div id="airwallex-error-message" class="text-danger small mt-2" role="alert"></div>
        </div>
    </template>

    <!-- 2. 前端網頁支付表單繼承：根據幣別動態追加對應圖標 -->
    <template id="airwallex_dynamic_logos" inherit_id="payment.method_form">
        
        <!-- 精準定位：在 Airwallex 圖標所在的 flex 容器內部追加新圖標 -->
        <xpath expr="//div[contains(@class, 'gap-1') and contains(@class, 'flex-wrap') and contains(@class, 'd-flex')]/*[1]" position="before">
            
            <!-- 1. 取得當前網頁或購物車的結帳幣別 -->
            <t t-set="current_currency" t-value="currency.name or website_sale_order.currency_id.name or website.currency_id.name"/>
            
            <!-- 2. 取得目前支付方式的 Code 變數 -->
            <t t-set="current_code" t-value="(pm_sudo and pm_sudo.code) or (logo_pm_sudo and logo_pm_sudo.code)"/>
            
            <!-- 3. 核心條件判斷：必須是 Airwallex 管道 -->
            <t t-if="current_code == 'airwallex'">
                
                <!-- 【情境 A】如果是港幣 HKD CNY SGD KRW（保留您之前的成功邏輯） -->
                <t t-if="current_currency == 'HKD'">
                    <img t-att-src="'/payment_airwallex/static/description/payme.png'" 
                         class="img-fluid o_payment_option_img" 
                         alt="Payme"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/wechat_pay.png'" 
                         class="img-fluid o_payment_option_img" 
                         alt="WechatPay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                </t>
                <t t-if="current_currency == 'CNY'">                    
                    <img t-att-src="'/payment_airwallex/static/description/wechat_pay.png'" 
                         class="img-fluid o_payment_option_img" 
                         alt="WechatPay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                </t>
                <t t-if="current_currency == 'SGD'">   
                    <img t-att-src="'/payment_airwallex/static/description/paynow.png'"
                         class="img-fluid o_payment_option_img" 
                         alt="PayNow"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/wechat_pay.png'" 
                         class="img-fluid o_payment_option_img" 
                         alt="WechatPay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                </t>
                <t t-if="current_currency == 'KRW'">   
                    <img t-att-src="'/payment_airwallex/static/description/kakaopay.png'"
                         class="img-fluid o_payment_option_img" 
                         alt="KakaoPay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                </t>
                
                <!-- 【情境 B】當幣別「不是」HKD CNY SGD KRW 時，同時並排顯示 card brand -->
                <t t-elif="current_currency not in ['HKD', 'CNY', 'SGD', 'KRW']">
                    <img t-att-src="'/payment_airwallex/static/description/applepay.png'" 
                         class="img-fluid o_payment_option_img" alt="Applepay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/gpay.png'" 
                         class="img-fluid o_payment_option_img" alt="Googlepay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/visa.png'" 
                         class="img-fluid o_payment_option_img" alt="VISA"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/mastercard.png'" 
                         class="img-fluid o_payment_option_img" alt="MasterCard"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/jcb.png'" 
                         class="img-fluid o_payment_option_img" alt="JCB"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>
                    <img t-att-src="'/payment_airwallex/static/description/wechat_pay.png'" 
                         class="img-fluid o_payment_option_img" alt="WechatPay"
                         style="width: 45px; height: 30px; object-fit: contain; vertical-align: middle; border-radius: 4px;"/>

                </t>
                
            </t>
            
        </xpath>
    </template>    
</odoo>
