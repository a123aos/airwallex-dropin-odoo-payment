<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Airwallex Bank Transfer is asynchronous. Keep Odoo's native payment
        status page and layout, but mark this specific transaction so the
        frontend can stop the generic post-processing polling and display a
        bank-transfer-specific pending message.
    -->
    <template id="payment_status_airwallex_bank_transfer"
              inherit_id="payment.payment_status"
              name="Airwallex Bank Transfer Payment Status">
        <xpath expr="//div[@name='o_payment_status']" position="attributes">
            <attribute name="data-airwallex-bank-transfer-pending">
                <t t-out="'1' if tx.provider_id.code == 'airwallex' and tx.payment_method_code == 'bank_transfer' and tx.state == 'pending' else '0'"/>
            </attribute>
        </xpath>
    </template>
</odoo>
